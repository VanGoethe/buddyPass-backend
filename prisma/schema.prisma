generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  local
  google
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id          String        @id @default(cuid())
  email       String        @unique
  name        String?
  password    String?
  avatar      String?
  googleId    String?       @unique
  provider    AuthProvider?
  role        UserRole      @default(USER)
  isVerified  Boolean       @default(false)
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  lastLoginAt DateTime?

  refreshTokens        RefreshToken[]
  subscriptionSlots    SubscriptionSlot[]
  subscriptionRequests SubscriptionRequest[]
  credentialReveals    CredentialReveal[]
  loginIncidents       LoginIncident[]
  notifications        Notification[]
  payments             Payment[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  familyId  String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

model Currency {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  symbol    String?
  minorUnit Int      @default(2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  countries     Country[]
  subscriptions Subscription[]
  payments      Payment[]

  @@map("currencies")
}

model Country {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  alpha3      String   @unique
  numericCode String?  @unique
  continent   String?
  region      String?
  currencyId  String?
  phoneCode   String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  currency             Currency?                @relation(fields: [currencyId], references: [id], onDelete: SetNull)
  serviceProviders     ServiceProviderCountry[]
  subscriptions        Subscription[]
  subscriptionRequests SubscriptionRequest[]
  capacityAlerts       CapacityAlert[]

  @@index([currencyId])
  @@map("countries")
}

model ServiceProvider {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  iconUrl     String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions        Subscription[]
  supportedCountries   ServiceProviderCountry[]
  subscriptionRequests SubscriptionRequest[]
  capacityAlerts       CapacityAlert[]

  @@map("service_providers")
}

model ServiceProviderCountry {
  id                String   @id @default(cuid())
  serviceProviderId String
  countryId         String
  createdAt         DateTime @default(now())

  serviceProvider ServiceProvider @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)
  country         Country         @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([serviceProviderId, countryId])
  @@index([countryId])
  @@map("service_provider_countries")
}

model Subscription {
  id                   String    @id @default(cuid())
  serviceProviderId    String
  countryId            String?
  name                 String
  email                String
  passwordCiphertext   String    @default("")
  passwordIv           String    @default("")
  passwordTag          String    @default("")
  keyVersion           Int       @default(1)
  needsCredentialReset Boolean   @default(false)
  maxSlots             Int
  expiresAt            DateTime?
  renewalInfo          Json?
  userPrice            Decimal?
  accountCost          Decimal?
  currencyId           String?
  metadata             Json?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  serviceProvider   ServiceProvider    @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)
  country           Country?           @relation(fields: [countryId], references: [id], onDelete: SetNull)
  currency          Currency?          @relation(fields: [currencyId], references: [id], onDelete: SetNull)
  subscriptionSlots SubscriptionSlot[]
  capacityAlerts    CapacityAlert[]
  credentialReveals CredentialReveal[]
  loginIncidents    LoginIncident[]
  payments          Payment[]

  @@index([serviceProviderId, countryId, isActive])
  @@index([currencyId])
  @@map("subscriptions")
}

enum SlotAccess {
  AWAITING_PAYMENT
  ACTIVE
  BLOCKED
}

model SubscriptionSlot {
  id             String     @id @default(cuid())
  userId         String
  subscriptionId String
  assignedAt     DateTime   @default(now())
  isActive       Boolean    @default(true)
  releasedAt     DateTime?
  access         SlotAccess @default(AWAITING_PAYMENT)
  termStartsAt   DateTime?
  termEndsAt     DateTime?
  blockedAt      DateTime?
  aliasLocalPart String     @unique
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription      Subscription          @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  assignedRequest   SubscriptionRequest?
  credentialReveals CredentialReveal[]
  loginCodes        LoginCode[]
  loginIncidents    LoginIncident[]
  payments          Payment[]

  @@index([subscriptionId, isActive])
  @@index([userId])
  @@index([access, termEndsAt])
  @@index([access, assignedAt])
  @@map("subscription_slots")
}

enum SubscriptionRequestStatus {
  PENDING
  ASSIGNED
  REJECTED
  CANCELLED
}

model SubscriptionRequest {
  id                String                    @id @default(cuid())
  userId            String
  serviceProviderId String
  countryId         String?
  status            SubscriptionRequestStatus @default(PENDING)
  assignedSlotId    String?                   @unique
  requestedAt       DateTime                  @default(now())
  processedAt       DateTime?
  metadata          Json?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceProvider ServiceProvider   @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)
  country         Country?          @relation(fields: [countryId], references: [id], onDelete: SetNull)
  assignedSlot    SubscriptionSlot? @relation(fields: [assignedSlotId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([serviceProviderId, countryId, status])
  @@map("subscription_requests")
}

enum CapacityAlertStatus {
  OPEN
  RESOLVED
}

model CapacityAlert {
  id                    String              @id @default(cuid())
  serviceProviderId     String
  countryId             String?
  poolKey               String
  openPoolKey           String?             @unique
  status                CapacityAlertStatus @default(OPEN)
  headroom              Int
  pendingCount          Int
  packingSubscriptionId String?
  recentRatePerHour     Float?
  historicalFillMs      BigInt?
  etaMs                 BigInt?
  horizonMs             BigInt?
  openedAt              DateTime            @default(now())
  resolvedAt            DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  serviceProvider     ServiceProvider @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)
  country             Country?        @relation(fields: [countryId], references: [id], onDelete: Cascade)
  packingSubscription Subscription?   @relation(fields: [packingSubscriptionId], references: [id], onDelete: SetNull)

  @@index([status, openedAt])
  @@index([serviceProviderId])
  @@map("capacity_alerts")
}

model CredentialReveal {
  id             String   @id @default(cuid())
  actorUserId    String
  slotId         String
  subscriptionId String
  createdAt      DateTime @default(now())

  actor        User             @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  slot         SubscriptionSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  subscription Subscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@map("credential_reveals")
}

model LoginCode {
  id         String   @id @default(cuid())
  slotId     String?
  alias      String
  code       String
  receivedAt DateTime @default(now())

  slot SubscriptionSlot? @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([slotId, receivedAt])
  @@index([receivedAt])
  @@map("login_codes")
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

model LoginIncident {
  id             String         @id @default(cuid())
  slotId         String
  userId         String
  subscriptionId String
  note           String
  status         IncidentStatus @default(OPEN)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  resolvedAt     DateTime?

  slot         SubscriptionSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, status])
  @@index([slotId])
  @@map("login_incidents")
}

enum NotificationKind {
  PROVIDER_EXPIRY
  SEAT_EXPIRY
  SEAT_CHANGE
  PAYMENT_CONFIRMATION
}

enum NotificationStage {
  NONE
  WEEK
  DAY
}

model Notification {
  id              String             @id @default(cuid())
  recipientUserId String
  kind            NotificationKind
  body            String
  subscriptionId  String?
  slotId          String?
  paymentId       String?
  stage           NotificationStage  @default(NONE)
  dedupeKey       String?            @unique
  readAt          DateTime?
  createdAt       DateTime           @default(now())

  recipient User @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, createdAt])
  @@index([kind, createdAt])
  @@map("notifications")
}

enum PaymentMethod {
  IHELLA
  LUMICASH
  ENOTI
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model Payment {
  id                   String        @id @default(cuid())
  userId               String
  slotId               String
  subscriptionId       String
  amount               Decimal
  currencyId           String
  method               PaymentMethod
  status               PaymentStatus @default(PENDING)
  providerRef          String?       @unique
  paidAt               DateTime?
  settledAfterRelease  Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot         SubscriptionSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  subscription Subscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  currency     Currency         @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@index([slotId, status])
  @@index([status, createdAt])
  @@map("payments")
}
