# Database
DATABASE_URL="postgresql://username:password@localhost:5432/buddypass_db"

# Server
PORT=3000
NODE_ENV=development
# Set to true when the app runs behind a reverse proxy
TRUST_PROXY=false

# JWT (minimum 32 characters; generate with: openssl rand -base64 48)
JWT_SECRET=replace_with_a_random_string_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_string_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AES-256-GCM key for shared subscription passwords. 32 bytes, base64-encoded.
# Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/users/auth/google/callback

# CORS
CORS_ORIGIN=http://localhost:3000

# Optional. When set, rate limits and socket events are shared across processes.
REDIS_URL=

# Required by `npm run create-admin`. No defaults.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=BuddyPass Admin

# Seat timing. Defaults apply when these are unset.
SEAT_PAYMENT_HOLD_HOURS=24
SEAT_BLOCK_GRACE_DAYS=3

# Login-code inbox. Polling stays off until IMAP_HOST, IMAP_USER, and IMAP_PASSWORD are set.
# The mailbox must receive mail sent to every streaming login address.
# Plus addressing (you+netflix1@gmail.com) or a catch-all domain both work.
# The login email stored on the account must be that exact address.
# INBOX_DOMAIN only matters for per-seat aliases (seat{slotId}@INBOX_DOMAIN).
INBOX_DOMAIN=
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# How long the active turn watches the inbox. This is not the countdown the customer sees.
LOGIN_CODE_WATCH_SECONDS=300
# How often that watch reads the inbox.
LOGIN_CODE_WATCH_INTERVAL_SECONDS=5
# Mail a few seconds older than the turn can still match.
LOGIN_CODE_CLOCK_SKEW_SECONDS=30
# Expected length of one turn, used only for the "starts in about" countdown.
LOGIN_CODE_TURN_ESTIMATE_SECONDS=45

# Outbound notices. The notice table is written either way.
# Mail sends only when SMTP_HOST and SMTP_FROM are set.
# Brevo free relay: 300 emails/day, no card. Host below, port 587 (STARTTLS).
# SMTP_USER is the SMTP login from Brevo (often id@smtp-brevo.com), not the From address.
# SMTP_PASSWORD is the SMTP key, not the API key.
# SMTP_FROM must be a sender verified in Brevo. A display name is allowed:
#   SMTP_FROM="BuddyPass <you@example.com>"
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Customer frontend origin used in verification and password-reset links.
# Defaults to the first CORS_ORIGIN when unset.
APP_PUBLIC_URL=

# Ihella. Charges are sent only when both the base URL and the key are set.
IHELLA_API_BASE_URL=
IHELLA_API_KEY=
IHELLA_WEBHOOK_SECRET=
