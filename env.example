# Database
DATABASE_URL="postgresql://username:password@localhost:5432/buddypass_db"

# Server
PORT=3000
NODE_ENV=development
# Set to true when the app runs behind a reverse proxy
TRUST_PROXY=false

# JWT (minimum 32 characters; generate with: openssl rand -base64 48)
JWT_SECRET=replace_with_a_random_string_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_string_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AES-256-GCM key for shared subscription passwords. 32 bytes, base64-encoded.
# Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/users/auth/google/callback

# CORS
CORS_ORIGIN=http://localhost:3000

# Optional. When set, rate limits are shared across processes.
REDIS_URL=

# Required by `npm run create-admin`. No defaults.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=BuddyPass Admin
